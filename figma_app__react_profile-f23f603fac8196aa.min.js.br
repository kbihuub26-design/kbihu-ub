  const [hovering, setHovering] = useState(false);
  const [cursor, setCursor] = useState({ x: 0, y: 0 });

  const handlePointerMove = (event: PointerEvent<HTMLDivElement>) => {
    const rect = event.currentTarget.getBoundingClientRect();
    setCursor({ x: event.clientX - rect.left, y: event.clientY - rect.top });
  };

  // The hover layer is the same dot grid scaled up, revealed only within a soft
  // circle that follows the cursor \u{2014} so dots appear to bloom under the pointer.
  const mask = \`radial-gradient(circle at $\{cursor.x}px $\{cursor.y}px, #000 72px, transparent 120px)\`;

  const container: CSSProperties = {
    position: "relative",
    width: "100%",
    height: "100%",
    overflow: "hidden",
    backgroundColor: "#f8fbff",
  };
  const dots: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 1.2px, transparent 1.4px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
  };
  const dotsHover: CSSProperties = {
    position: "absolute",
    inset: 0,
    backgroundImage:
      "radial-gradient(circle at center, rgba(157, 200, 255, 0.52) 2.16px, transparent 2.36px)",
    backgroundPosition: "center",
    backgroundSize: "18px 18px",
    opacity: hovering ? 1 : 0,
    maskImage: mask,
    WebkitMaskImage: mask,
  };

  return (
    <div
      style={container}
      onPointerEnter={() => setHovering(true)}
      onPointerMove={handlePointerMove}
      onPointerLeave={() => setHovering(false)}
    >
      <div style={dots} />
      <div style={dotsHover} />
    </div>
  );
}`;n.d(t,{},{Ar:"/src/styles/index.css",DZ:"/styles/globals.css",VY:"/src/styles/theme.css",eu:"/src/styles",jP:r,oA:i})},382206(e,t,n){var r=n(75950),i=n(380592),a=n(127020),o=n(229472),s=n(379659),l=n(566048),d=n(942813),c=n(122795),u=n(669550),p=n(430664),_=n(313302),m=n(382260),h=n(184665),f=n(358726);async function g({nodes:e,shouldExportImageFill:t,getFallbackFill:n,functionalDependencies:r}){let{trackExport:i}=r;async function a(){let i=function(e){var t;if(e.length>1)return!1;let n=e[0];if(!n.fills||!n.size||!n.size.x||!n.size.y)return!1;let r=n.fills.map((e,t)=>({fill:e,index:t})).filter(({fill:e})=>!1!==e.visible&&(e.opacity??1)>0);if(1!==r.length)return!1;let i=r[0];if(i?.fill.type!=="IMAGE"||(t=n.absoluteTransform)&&t.m00*t.m11-t.m01*t.m10<0)return!1;let a=m.Pjp?.getUVTransformForImageTarget({guid:n.guid,fillIndex:i.index,componentPropDefId:null});return!!a&&function(e,t=1e-6){return!e||Math.abs(e.m00-1)<t&&Math.abs(e.m01)<t&&Math.abs(e.m02)<t&&Math.abs(e.m10)<t&&Math.abs(e.m11-1)<t&&Math.abs(e.m12)<t}(a)}(e);return t&&!i?{...await y(e,r),shouldExport:t,canSkipExport:i,exported:!0}:{...{node:e[0],fill:await n(),cleanup:()=>{}},shouldExport:t,canSkipExport:i,exported:!1}}return(0,l.r)(a,i)}async function y(e,t){let n=function(e){if(e.length>1)return"image/png";let t=e[0],n=t.fills?.find(e=>"IMAGE"===e.type&&!1!==e.visible),r=n?.image?.hash;if(!r)return"image/png";let i=h.Bko?.getCompressedImage((0,o.Rw)(r));return!i||i.byteLength<=4?"image/png":(0,a.ER)(i).mimeType}(e),{width:r,height:i,blob:s,loadImagesLatencyMs:l}=await (0,p.o4)(e,{exportSettings:[{contentsOnly:!0,constraint:function(e){if(e.length>1){let{width:t,height:n}=v(e);return I(t,n,4096)??{type:"CONTENT_SCALE",value:1}}let t=e[0];if(!t.size||!t.size.x||!t.size.y)return{type:"CONTENT_SCALE",value:1};let n=I(t.size.x,t.size.y,4096);if(n)return n;let r=t.fills?.filter(e=>"IMAGE"===e.type)??[];return 0===r.length?{type:"CONTENT_SCALE",value:Math.max(1024/Math.max(t.size.x,t.size.y),1)}:{type:"CONTE