          --consent-font-size-large: 15px;
          --consent-line-height-large: 25px;
          --consent-banner-padding: 1.5rem;
        }
      }

      .button-wide {
        width: 100%;
      }

      @media (max-width: 480px) {
        .cookie-consent-banner {
          flex-direction: column;
        }

        .cookie-consent-button-group {
          flex-direction: row;
          width: 100%;
        }
      }
